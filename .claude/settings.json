{
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push -u origin claude/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/preparer_r.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true
  }
}
