# Fins de ligne LF dans le depot et sur tous les postes (Windows local, cloud
# Linux), pour eviter les diffs parasites.
* text=auto eol=lf

*.R    text eol=lf
*.tex  text eol=lf
*.md   text eol=lf
*.csv  text eol=lf

*.pdf  binary
*.xlsx binary
*.png  binary
*.jpg  binary
# References de non-regression (tests/reference/*.rds) : binaires par
# attribut, et non plus par seule detection heuristique, pour qu'aucune
# conversion de fin de ligne ne touche un .rds telecharge d'un artefact de
# la CI et commite (issue #67).
*.rds  binary
